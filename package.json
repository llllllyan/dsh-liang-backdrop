{
  "name": "dsh-liang-backdrop",
  "repository": { "type": "git", "url": "git+https://github.com/llllllyan/dsh-liang-backdrop.git" },
  "version": "1.1.0",
  "type": "module",
  "description": "把「小难梁 → 梁祖」六张状态图铺成 DSH 窗口背景；面板可拖拽、可收起，中英文实时切换。Six Liang portraits pinned behind your DSH window, with a bilingual (中文/English) panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "backdrop",
    "wallpaper",
    "desktop-pet",
    "meme",
    "liang"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
